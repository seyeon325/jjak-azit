# 서버 포트 (배포 환경에서는 보통 자동으로 지정됩니다)
PORT=3000
# 참가자에게 안내할 공개 주소 (관전 화면 QR 코드에 사용). 비워두면 자동 감지합니다.
PUBLIC_URL=
# 최대 동시 접속 인원
MAX_PLAYERS=60
# 연결이 끊긴 참가자를 기다려주는 시간(초). 이 시간 안에 돌아오면 같은 캐릭터로 복귀합니다.
RECONNECT_GRACE_SEC=45
# 학회장 비밀번호 — 실제 값은 이 파일이나 Git 에 적지 말고 호스팅 환경변수에만 넣으세요.
# ADMIN_PASSWORD=          (비밀번호 문자열, 앞자리 0도 그대로 유지)
# ADMIN_PASSWORD_HASH=     (권장: npm run hashpw 로 만든 scrypt$... 값. 있으면 이것을 우선 사용)
