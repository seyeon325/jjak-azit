{
  "name": "jjak-azit",
  "version": "0.1.0",
  "private": true,
  "description": "짝선짝후 아지트 — 2026PAIR 선후배 교류 행사용 웹 멀티플레이 메타버스",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "cross-env PORT=3000 NODE_ENV=development ADMIN_PASSWORD=azit-dev tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "bots": "tsx scripts/bots.ts",
    "raidbots": "tsx scripts/raidbots.ts",
    "selftest": "tsx scripts/selftest.ts",
    "hashpw": "tsx scripts/hashpw.ts"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "cross-env": "^10.1.0",
    "express": "^4.22.3",
    "galmuri": "^2.40.3",
    "phaser": "^3.90.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "concurrently": "^10.0.7",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  }
}
